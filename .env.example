# Gnani AI Speech API Configuration (Required for live microphone STT and Timbre TTS)
# Obtain your API key from the Gnani developer portal: https://app.gnani.ai/
GNANI_API_KEY="your_gnani_api_key_here"
GNANI_BASE_URL="https://api.vachana.ai"

# TTS Model & Voice Configuration
TTS_MODEL="timbre-v3.0"
TTS_VOICE="Shivani"
TTS_SPEED="1.0"

# Gemini AI API Key (Optional: powers conversational grounding behind the deterministic clinical safety rules)
# When provided, Gemini 2.5 Flash handles natural conversational phrasing grounded in hospital_data.json.
# If omitted, the system operates in 100% deterministic rule-based mode.
GEMINI_API_KEY=""

# Hospital Reception Staff PIN (Secure 6-digit PIN)
# Protects patient telephone numbers on the Reception Desk dashboard
# MUST be customized. Default, placeholder (CHANGE_ME), or weak PINs will be refused on startup.
STAFF_PIN="CHANGE_ME"

# Server Port
PORT=3000
